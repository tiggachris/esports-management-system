<%- include('partials/header') %>

<div class="home-page">
    <!-- Hero Section -->
    <div class="hero-section text-center py-5 mb-5">
        <div class="container">
            <div class="brand-logo mb-4">
                <img src="/images/logo.png" alt="Apex Grid Logo" class="img-fluid" style="max-width: 200px;">
            </div>
            <h1 class="display-4 mb-3">APEX GRID</h1>
            <p class="lead mb-4">PEAK PERFORMANCE, STRUCTURED DOMINANCE</p>
        </div>
    </div>

    <!-- Image Carousel Section -->
    <link rel="stylesheet" href="/css/carousel.css">
    <div class="container mb-5">
        <div class="carousel-container">
            <div class="carousel-wrapper">
                <div class="carousel-slide">
                    <img src="/images/carousel-images/carousel-1.jpg" alt="Esports Event 1" class="carousel-image">
                </div>
                <div class="carousel-slide">
                    <img src="/images/carousel-images/carousel-2.jpg" alt="Esports Event 2" class="carousel-image">
                </div>
                <div class="carousel-slide">
                    <img src="/images/carousel-images/carousel-3.jpg" alt="Esports Event 3" class="carousel-image">
                </div>
                <div class="carousel-slide video-slide">
                    <video src="/images/carousel-images/carousel-4.mp4" class="carousel-video" muted loop autoplay playsinline></video>
                </div>
            </div>
            <button class="carousel-button prev">
                <i class="fas fa-chevron-left"></i>
            </button>
            <button class="carousel-button next">
                <i class="fas fa-chevron-right"></i>
            </button>
            <div class="carousel-indicators"></div>
        </div>
    </div>
    <script src="/js/carousel.js"></script>

    <!-- Gaming News Section -->
    <div class="container mb-5">
        <h2 class="section-title text-center mb-4">LATEST GAMING NEWS</h2>
        <div class="row">
            <!-- News Card 1 -->
            <div class="col-md-4 mb-4">
                <div class="news-card">
                    <img src="/images/news/valorant-update.jpg" alt="Valorant Update" class="news-image">
                    <div class="news-content">
                        <h3 class="news-title">Valorant Introduces New Agent</h3>
                        <p class="news-date">December 15, 2023</p>
                        <p class="news-excerpt">The latest agent brings revolutionary tactical abilities to reshape the competitive meta.</p>
                        <a href="#" class="read-more">Read More</a>
                    </div>
                </div>
            </div>
            <!-- News Card 2 -->
            <div class="col-md-4 mb-4">
                <div class="news-card">
                    <img src="/images/news/league-worlds.jpg" alt="League Worlds" class="news-image">
                    <div class="news-content">
                        <h3 class="news-title">League Worlds 2023 Breaks Records</h3>
                        <p class="news-date">December 14, 2023</p>
                        <p class="news-excerpt">The championship final sees unprecedented viewership numbers across all platforms.</p>
                        <a href="#" class="read-more">Read More</a>
                    </div>
                </div>
            </div>
            <!-- News Card 3 -->
            <div class="col-md-4 mb-4">
                <div class="news-card">
                    <img src="/images/news/csgo-tournament.jpg" alt="CS:GO Tournament" class="news-image">
                    <div class="news-content">
                        <h3 class="news-title">Major CS:GO Tournament Announced</h3>
                        <p class="news-date">December 13, 2023</p>
                        <p class="news-excerpt">The biggest CS:GO tournament of 2024 will feature a $2 million prize pool.</p>
                        <a href="#" class="read-more">Read More</a>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Social Media Section -->
    <div class="container mb-5">
        <div class="text-center">
            <h2 class="section-title mb-4">FOLLOW US</h2>
            <div class="social-links">
                <a href="#" class="social-link"><i class="fab fa-twitter"></i></a>
                <a href="#" class="social-link"><i class="fab fa-discord"></i></a>
                <a href="#" class="social-link"><i class="fab fa-twitch"></i></a>
                <a href="#" class="social-link"><i class="fab fa-youtube"></i></a>
            </div>
        </div>
    </div>
</div>

<%- include('partials/footer') %>
